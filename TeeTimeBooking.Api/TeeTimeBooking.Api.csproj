<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 11 runtime async: the runtime suspends and resumes async methods instead of compiler-generated state
         machines. Shorter live stack traces, fewer allocations per await. RuntimeAsyncTests fails if this goes. -->
    <Features>runtime-async=on</Features>
    <UserSecretsId>teetime-booking-demo</UserSecretsId>
    <Version>1.0.0</Version>
    <!-- The SDK appends the commit to InformationalVersion: from .git locally, from SourceRevisionId in Docker. -->
  </PropertyGroup>

  <!-- A Debug build writes the OpenAPI document to web/openapi.json, the contract the UI's types are checked against.
       CI builds it again and fails if the committed copy is stale. Release builds (tests, Docker) skip it. -->
  <PropertyGroup>
    <OpenApiGenerateDocuments Condition="'$(Configuration)' != 'Debug'">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../web</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildTimestamp)' != ''">
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OpenAPI document is built in (Microsoft.AspNetCore.OpenApi); Swagger UI only renders it. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- Azure SQL via the managed identity. SqlClient 7 moved Entra ID authentication into this package. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
