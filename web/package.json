{
  "name": "teetime-booking-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "api:types": "swagger-typescript-api generate -p openapi.json -o src -n api.gen.ts --no-client --enum-style=union --silent",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "swagger-typescript-api": "13.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
