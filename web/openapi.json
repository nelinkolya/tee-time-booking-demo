{
  "openapi": "3.1.1",
  "info": {
    "title": "Tee Time Booking API",
    "description": "Books spots on golf tee times without overbooking under concurrent requests, and without duplicates when one request is retried: send a unique `Idempotency-Key` header per booking attempt and reuse it on retries.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tee-times": {
      "get": {
        "tags": [
          "Tee times"
        ],
        "summary": "List the tee times of one day",
        "description": "`date` is `yyyy-MM-dd`, course-local; today when omitted.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeeTimeDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tee-times/{id}/bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "List the bookings of a tee time, cancelled ones included",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Book spots on a tee time",
        "description": "Send a unique `Idempotency-Key` per booking attempt (a UUID works) and reuse it when retrying.\n\n- **201** — booked.\n- **200** — a retry of an attempt that already succeeded: the original booking, header `Idempotent-Replayed: true`; nothing new is booked.\n- **409** — not enough free spots; `availableSpots` says how many are left.\n- **422** — the key was already used for a different request.\n\nConcurrent requests for the same tee time are serialised by the database, so it is never overbooked.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancel a booking and free its spots",
        "description": "Idempotent: cancelling an already cancelled booking returns it unchanged.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "The running version: release, commit and build time",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingDto": {
        "required": [
          "id",
          "teeTimeId",
          "playerName",
          "players",
          "status",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "teeTimeId": {
            "type": "integer",
            "format": "int32"
          },
          "playerName": {
            "type": "string"
          },
          "players": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BookingRequest": {
        "required": [
          "playerName",
          "players"
        ],
        "type": "object",
        "properties": {
          "playerName": {
            "type": "string"
          },
          "players": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BookingStatus": {
        "enum": [
          "Confirmed",
          "Cancelled"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TeeTimeDto": {
        "required": [
          "id",
          "course",
          "startsAt",
          "capacity",
          "bookedPlayers",
          "availableSpots"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "course": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "bookedPlayers": {
            "type": "integer",
            "format": "int32"
          },
          "availableSpots": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "VersionDto": {
        "required": [
          "version",
          "commit",
          "builtAtUtc",
          "environment"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "commit": {
            "type": [
              "null",
              "string"
            ]
          },
          "builtAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "environment": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tee times"
    },
    {
      "name": "Bookings"
    },
    {
      "name": "Meta"
    }
  ]
}